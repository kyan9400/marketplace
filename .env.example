# PostgreSQL connection string used by Prisma (see prisma/schema.prisma)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/marketplace?schema=public

# Secret for NextAuth JWT sessions (src/lib/auth.ts). Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Public base URL of the site; required by NextAuth v4 when not running on localhost
NEXTAUTH_URL=http://localhost:3000
